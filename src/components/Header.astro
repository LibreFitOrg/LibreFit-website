---
const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/privacy.html', label: 'Privacy', icon: 'policy' },
  { href: '/donate.html', label: 'Donate', icon: 'favorite' },
  { href: '/license.html', label: 'License', icon: 'license' },
  { href: '/contact.html', label: 'Contact', icon: 'person' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="LibreFit Home">
      <span class="brand-icon">
        <img class="brand-logo" src="/assets/logo_trimmed.svg" alt="LibreFit logo">
      </span>
      <p class="brand-title">
        <span class="brand-title-accent">Libre</span>Fit
      </p>
    </a>

    <nav class="nav-chips" aria-label="Primary navigation">
      {links.map(({ href, label, icon }) => (
        isCurrent(href) ? (
          <a class="md-assist-chip active" aria-current="page">
            <span class="material-symbols-outlined">{icon}</span>
            {label}
          </a>
        ) : (
          <a href={href} class="md-assist-chip">
            <span class="material-symbols-outlined">{icon}</span>
            {label}
          </a>
        )
      ))}
    </nav>
  </div>
</header>