---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LibreFit - Page not found"
  description="This page wasn't found, but you can head back to the homepage."
  robots="noindex,follow"
>
  <section class="grid items-start gap-6 pt-[clamp(1rem,4vw,1.5rem)] pb-[clamp(2rem,6vw,72px)]" aria-labelledby="hero-title">
    <div>
      <h1 class="m-0 mb-3 md-typescale-display-medium">Page Not Found</h1>
      <p class="m-0 mb-5 md-typescale-body-large text-on-surface-variant">Sorry, the page you are looking for doesn't exist or has been moved.</p>

      <a href="/" class="md-filled-button">
        <span class="material-symbols-outlined">home</span>
        Go to home
      </a>
    </div>
  </section>
</BaseLayout>