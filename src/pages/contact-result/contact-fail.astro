---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LibreFit - Form submission failed"
  description="Form submission encountered an unexpected error. Try again later."
  canonical="/contact-result/contact-fail.html"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 class="hero-title md-typescale-display-medium">Message not sent</h1>
      <p class="hero-subtitle md-typescale-body-large">There was an unexpected error when sending the message. Please, try to use other communication methods and inform the administrator about this error.</p>

      <a href="/contact.html" class="md-filled-button">
        <span class="material-symbols-outlined">arrow_back</span>
        Go back
      </a>
    </div>
  </section>
</BaseLayout>