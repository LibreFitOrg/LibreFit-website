---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LibreFit - Invalid form data"
  description="Form submission encountered an error due to invalid data. Try again."
  canonical="/contact-result/contact-invalid-data.html"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 class="hero-title md-typescale-display-medium">Message not sent</h1>
      <p class="hero-subtitle md-typescale-body-large">The email is empty or the message is empty or too long (max 1000 characters) or the submitted pgp file is not valid.</p>

      <a href="/contact.html" class="md-filled-button">
        <span class="material-symbols-outlined">arrow_back</span>
        Go back
      </a>
    </div>
  </section>
</BaseLayout>