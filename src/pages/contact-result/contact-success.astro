---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LibreFit - Form submission success"
  description="Form submission was completed successfully."
  canonical="/contact-result/contact-success.html"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 class="hero-title md-typescale-display-medium">Thank you</h1>
      <p class="hero-subtitle md-typescale-body-large">Your message has been sent successfully.</p>

      <a href="/contact.html" class="md-filled-button">
        <span class="material-symbols-outlined">arrow_back</span>
        Go back
      </a>
    </div>
  </section>
</BaseLayout>