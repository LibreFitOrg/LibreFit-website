---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LibreFit - Form submission success"
  description="Form submission was completed successfully."
  canonical="/contact-result/contact-success.html"
>
  <section class="grid items-start gap-6 pt-[clamp(1rem,4vw,1.5rem)] pb-[clamp(2rem,6vw,72px)]" aria-labelledby="hero-title">
    <div>
      <h1 class="m-0 mb-3 md-typescale-display-medium">Thank you</h1>
      <p class="m-0 mb-5 md-typescale-body-large text-on-surface-variant">Your message has been sent successfully.</p>

      <a href="/contact.html" class="md-filled-button">
        <span class="material-symbols-outlined">arrow_back</span>
        Go back
      </a>
    </div>
  </section>
</BaseLayout>